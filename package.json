{
  "name": "stepanfactory",
  "productName": "StepanFactory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run check && electron-vite build",
    "start": "electron .",
    "lint": "oxlint --deny-warnings --ignore-pattern docs-lint/rejected/ .",
    "typecheck": "tsc -p src/core.tsconfig.json && tsc -p src/main && tsc -p src/renderer",
    "docs-lint": "node docs-lint/verify.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run docs-lint",
    "predev": "install-electron",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@reatom/core": "1001.3.0",
    "@reatom/react": "1001.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-vite": "6.0.0",
    "ky": "2.1.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
